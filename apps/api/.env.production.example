APP_ENV=production
JWT_SECRET=            # >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/medibridge
CORS_ORIGINS=https://your-web-domain.example
UPLOAD_DIR=/var/lib/medibridge/uploads
ANTHROPIC_API_KEY=     # optional, server-side only
