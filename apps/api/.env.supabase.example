# Copy to .env and fill in. NEVER commit .env or paste these values into chats/issues.
APP_ENV=production
JWT_SECRET=                                  # python -c "import secrets;print(secrets.token_urlsafe(48))"
# Dashboard -> Connect -> Session pooler. Change the scheme to postgresql+psycopg:// , REMOVE the [ ] around the password,
# and URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F, : -> %3A).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
STORAGE_BACKEND=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                   # Dashboard -> Project Settings -> API Keys -> SECRET key (sb_secret_...). NOT the publishable key.
SUPABASE_BUCKET=reports                      # create as a PRIVATE bucket
CORS_ORIGINS=https://<your-web-domain>
EMAIL_PROVIDER=resend                        # resend | smtp | none
RESEND_API_KEY=
EMAIL_FROM=MediBridge <onboarding@resend.dev>   # resend.dev sender can only email YOUR Resend account address until you verify a domain
ANTHROPIC_API_KEY=
